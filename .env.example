# BeastPing Mail Console configuration.
# Installed as /etc/mail-console/mail-console.env (root:mailconsole, mode 0640).
# This file contains no secrets by design: there are no default passwords and
# no SMTP credentials. Values must not contain spaces.

# --- Storage -------------------------------------------------------------------
MC_DATA_DIR=/var/lib/mail-console
# MC_DB_PATH=/var/lib/mail-console/mail-console.sqlite3

# --- Web interface ---------------------------------------------------------------
# Keep the bind address on loopback. Publish only through an HTTPS reverse
# proxy with access restrictions (docs/DEPLOYMENT.md).
MC_BIND=127.0.0.1
MC_PORT=8710
# Host names the console answers to besides 127.0.0.1/localhost (comma separated),
# e.g. the reverse-proxy name: MC_ALLOWED_HOSTS=console.example.com
MC_ALLOWED_HOSTS=
# Cookies are marked Secure. Browsers accept Secure cookies on http://localhost
# (SSH tunnel) and on HTTPS. Do not disable outside of local testing.
MC_COOKIE_SECURE=true
# Set to true only behind a reverse proxy on this host that sets X-Forwarded-For.
MC_TRUST_PROXY=false
MC_SESSION_IDLE_MINUTES=30
MC_SESSION_MAX_HOURS=12

# --- Log source (read-only) ----------------------------------------------------
# file: tail a syslog file; journald: read journalctl --output=json.
MC_LOG_SOURCE=file
MC_LOG_PATH=/var/log/syslog
# Time zone for log lines without an offset (traditional "Oct 27 10:46:29" format).
# ISO 8601 lines carry their own offset and ignore this.
MC_LOG_TIMEZONE=UTC
# Syslog program-name prefixes treated as Postfix (postfix/smtp, postfix/submission/smtpd, ...).
MC_POSTFIX_PREFIXES=postfix
# Other programs whose problems appear under Monitoring > Recent operational errors.
MC_OPS_PROGRAMS=opendkim,dovecot,mailguard
# Used only when MC_LOG_SOURCE=journald.
MC_JOURNAL_UNITS=postfix@-.service,opendkim.service,dovecot.service,mailguard.service
MC_POLL_INTERVAL=2

# --- Read-only monitoring ------------------------------------------------------
# Label=unit pairs checked with "systemctl show" (never started/stopped).
# Verify the Mailguard unit name with: systemctl list-units --all | grep -i guard
MC_MONITOR_UNITS=Postfix=postfix@-.service,Mailguard=mailguard.service,OpenDKIM=opendkim.service,Dovecot=dovecot.service
MC_MONITOR_INTERVAL=30
MC_POSTQUEUE=/usr/sbin/postqueue
MC_SYSTEMCTL=/usr/bin/systemctl

# --- Growth controls -------------------------------------------------------------
# Default retention; can be changed in Settings (the Settings value wins).
MC_RETENTION_DAYS=90
# Hard cap on live database size; oldest history is removed first when exceeded.
MC_MAX_DB_MB=2048
MC_MAX_EVENTS_PER_MESSAGE=2000
MC_BATCH_LINES=2000
MC_MAX_LINE_BYTES=16384
# Store the (redacted) raw log line with each event for the timeline.
MC_STORE_RAW_LINES=true
