# --- BeastPing Mail Console: message archive (MAIL-CONTENT-01) ---------------
# PROPOSAL FOR REVIEW. Apply with postconf -e (see docs/MAIL-CAPTURE.md).
#
# Route the archive address to the capture transport. PREPEND to the existing
# transport_maps (keep every existing table and its order), e.g.:
#   transport_maps = hash:/etc/postfix/mailconsole_transport, <existing value>
transport_maps = hash:/etc/postfix/mailconsole_transport, <existing transport_maps>
# One archive copy per pipe invocation.
mailconsole-archive_destination_recipient_limit = 1
